        String imagePath = "C:\\Users\\Arliana Pascual\\Downloads\\494357063_1126081262618383_7552793638603133344_n.jpg";
        ImageIcon imageIcon = new ImageIcon(imagePath);
        Image Simage = imageIcon.getImage().getScaledInstance(300, 200, Image.SCALE_DEFAULT); 
